{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "demo-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo-app",
      "sourceRoot": "projects/demo-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/demo-app"
            },
            "index": "projects/demo-app/src/index.html",
            "polyfills": [
              "projects/demo-app/src/polyfills.ts"
            ],
            "tsConfig": "projects/demo-app/tsconfig.app.json",
            "assets": ["projects/demo-app/src/assets"],
            "styles": ["projects/demo-app/src/styles.css"],
            "scripts": [],
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "projects/demo-app/src/main.ts"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "demo-app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "demo-app:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "demo-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/demo-app/src/test.ts",
            "polyfills": "projects/demo-app/src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": ["projects/demo-app/src/assets"],
            "styles": ["projects/demo-app/src/styles.css"],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/demo-app/src/**/*.ts",
              "projects/demo-app/src/**/*.html"
            ]
          }
        }
      }
    },
    "ngx-ts-riskid": {
      "projectType": "library",
      "root": "projects/ngx-ts-riskid",
      "sourceRoot": "projects/ngx-ts-riskid/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-ts-riskid/tsconfig.lib.json",
            "project": "projects/ngx-ts-riskid/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-ts-riskid/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/ngx-ts-riskid/src/test.ts",
            "tsConfig": "projects/ngx-ts-riskid/tsconfig.spec.json",
            "karmaConfig": "projects/ngx-ts-riskid/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/ngx-ts-riskid/src/lib/**/*.ts"]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"]
  }
}
